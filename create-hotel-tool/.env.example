# ===== 创维酒店管理系统配置 =====

# 酒店管理系统地址（生产环境）
HOTEL_URL=https://cooshare.coocaa.com/hotel

# 父节点ID（组织ID）
FID=404

# 登录账号
LOGIN_USERNAME=n8n

# 登录密码（MD5 哈希值）
# 当前值 = MD5("n8n123")
LOGIN_PASSWORD=[REDACTED_PASSWORD_HASH]

# 复制模板的源酒店ID
SOURCE_HOTEL_ID=214

# ===== DeepSeek API 配置（用于中文→拼音首字母转换）=====
# 获取方式：https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_MODEL=deepseek-chat

# ===== 画中平台（已禁用）=====
HUASHI_TOKEN=8d4a7e8d4b1c84e671959265cd31ca76

# ===== 服务器配置 =====
PORT=3000
