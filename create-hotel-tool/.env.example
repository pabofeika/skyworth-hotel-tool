# ===== 创维酒店管理系统配置 =====

# 酒店管理系统地址
# 测试环境: http://42.194.213.245/hotel
# 生产环境: https://cooshare.coocaa.com/hotel
HOTEL_URL=https://cooshare.coocaa.com/hotel

# 父节点ID（组织ID）
FID=404

# 登录账号
LOGIN_USERNAME=n8n

# 登录密码（MD5 哈希值，获取方式请联系系统管理员）
LOGIN_PASSWORD=your_login_password_hash_here

# 复制模板的源酒店ID
SOURCE_HOTEL_ID=214

# ===== DeepSeek API 配置（用于中文→拼音首字母转换）=====
# 获取方式：https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=sk-your-deepseek-api-key-here
DEEPSEEK_API_URL=https://api.deepseek.com/chat/completions
DEEPSEEK_MODEL=deepseek-chat

# ===== 刷机平台配置（可选）=====
HUASHI_URL=https://skyworth-business.com/huashi-api
HUASHI_USERNAME=your_huashi_username
HUASHI_PASSWORD=your_huashi_password

# ===== 服务器配置 =====
PORT=3000
REQUEST_TIMEOUT=30000
