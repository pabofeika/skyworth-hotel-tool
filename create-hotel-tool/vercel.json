{
  "version": 2,
  "builds": [
    {
      "src": "server.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "/server.js" },
    { "src": "/(.*)", "dest": "/server.js" }
  ],
  "env": {
    "HOTEL_URL": "@hotel-url",
    "FID": "@fid",
    "LOGIN_USERNAME": "@login-username",
    "LOGIN_PASSWORD": "@login-password",
    "SOURCE_HOTEL_ID": "@source-hotel-id",
    "HUASHI_URL": "@huashi-url",
    "HUASHI_USERNAME": "@huashi-username",
    "HUASHI_PASSWORD": "@huashi-password",
    "DEEPSEEK_API_KEY": "@deepseek-api-key",
    "DEEPSEEK_API_URL": "@deepseek-api-url",
    "DEEPSEEK_MODEL": "@deepseek-model",
    "REQUEST_TIMEOUT": "@request-timeout"
  }
}
